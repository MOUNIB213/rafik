# إن تركته فارغًا يستطيع أي شخص يملك الرابط استخدام الموقع على حسابك!
ACCESS_CODE=

PORT=3000

# ---- Google Gemini (الافتراضي) ----
# مفتاح مجاني من: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6Iat3VNrDE1HQFXTPuLQzis4iTCWEkXgQrOUgFe8TAHuA
# النموذج الأول في القائمة هو الافتراضي. الخادم يضيف تلقائيًا بقية نماذج Gemini المتاحة لمفتاحك.
